{
  "name": "serqo-sdk",
  "version": "0.1.1",
  "description": "Official JavaScript and TypeScript client for the Serqo Search API",
  "keywords": [
    "serp",
    "serp-api",
    "search-api",
    "google-search",
    "bing-search",
    "typescript"
  ],
  "homepage": "https://serqo.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/serqo-io/serqo-js.git"
  },
  "bugs": {
    "url": "https://github.com/serqo-io/serqo-js/issues"
  },
  "author": {
    "name": "Serqo",
    "url": "https://serqo.io"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "API.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
